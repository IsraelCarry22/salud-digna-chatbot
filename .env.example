# Copia este archivo como .env y cambia los valores.

# Clave compartida entre el bot y Evolution API (o el simulador)
EVOLUTION_API_KEY=cambia-esta-clave
EVOLUTION_INSTANCE=saluddigna

# A dónde manda el bot los mensajes:
#   Simulador (teléfono virtual, por defecto):  http://simulator:8080
#   Evolution API real (perfil "evolution"):    http://evolution-api:8080
EVOLUTION_URL=http://simulator:8080

# URL del orquestador omnicanal (déjalo vacío si aún no existe).
# Ej: http://host.docker.internal:4000/events
ORCHESTRATOR_URL=

# Solo para el perfil "evolution"
POSTGRES_PASSWORD=evolution123
WA_BUSINESS_TOKEN_WEBHOOK=saluddigna-verify

# ------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — developers.facebook.com > tu app > WhatsApp > API Setup
# ------------------------------------------------------------------
# Token de acceso (el temporal dura 24 h; para la demo larga usa un token de usuario del sistema)
META_TOKEN=
# "Phone number ID" del número de prueba (no es el número de teléfono)
META_PHONE_NUMBER_ID=
# Texto que tú inventas y pegas también en Meta al configurar el webhook
META_VERIFY_TOKEN=saluddigna-verify
# App Secret (Configuración de la app > Básica). Con él se verifica que los mensajes vengan de Meta
META_APP_SECRET=
META_API_VERSION=v25.0
# Plantilla para mensajes fuera de la ventana de 24 h (POST /notify con "plantilla": true)
META_TEMPLATE=hello_world
META_TEMPLATE_LANG=en_US
