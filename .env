# Copia este archivo como .env y cambia los valores.

# Clave compartida entre el bot y Evolution API (o el simulador)
EVOLUTION_API_KEY=cambia-esta-clave
EVOLUTION_INSTANCE=saluddigna

# A dónde manda el bot los mensajes:
#   Simulador (teléfono virtual, por defecto):  http://simulator:8080
#   Evolution API real (perfil "evolution"):    http://evolution-api:8080
EVOLUTION_URL=http://simulator:8080

# URL del orquestador omnicanal (déjalo vacío si aún no existe).
# Ej: http://host.docker.internal:4000/events
ORCHESTRATOR_URL=

# Solo para el perfil "evolution"
POSTGRES_PASSWORD=evolution123
WA_BUSINESS_TOKEN_WEBHOOK=saluddigna-verify
